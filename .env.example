# 复制为 .env.local。密钥只在服务端读取，不能使用 NEXT_PUBLIC_ 前缀。
# Gemini Developer API 与 Vertex Express API Key 二选一。
GEMINI_API_KEY=
VERTEX_AI_API_KEY=
# 旧的 VERTEX_AI_IMAGE_MODEL 不用于代码生成。
GEMINI_MODEL=gemini-3.5-flash

# Coding Agent 可选 GPT 配置（Responses API，需支持函数工具调用）。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Google 登录：在 Google Cloud 创建 Web 应用 OAuth 客户端。
# 授权重定向 URI 必须为 http://127.0.0.1:3000/api/auth/callback/google。
# 使用 Whistle HTTPS 代理时，AUTH_URL 只填来源，例如 https://pixloom.io；
# Google 回调同步填写 https://pixloom.io/api/auth/callback/google，不要混用 www。
# 首次成功登录的 Google 账号绑定本机工作空间，后续仅允许该账号登录。
# 两个凭证均留空时保留本机访客模式；填写任意一个后，工作台 API 要求登录。
PIXLOOM_GOOGLE_CLIENT_ID=
PIXLOOM_GOOGLE_CLIENT_SECRET=
PIXLOOM_AUTH_URL=http://127.0.0.1:3000

# 可选：SQLite 数据目录。默认是仓库根目录的 .pixloom/。
# Web 与 Worker 必须使用相同的目录，不可提交到 Git。
PIXLOOM_DATA_DIR=.pixloom

# 可选：Docker CLI 的可信绝对路径；默认自动发现 Docker Desktop。
# PIXLOOM_DOCKER_BIN=/Applications/Docker.app/Contents/Resources/bin/docker

# AI 任务优先使用 Chromium：先运行 pnpm browser:install；缺失时尝试本机 Chrome。
# 可选：使用已安装的 Google Chrome（独立临时 profile，不读取个人浏览器数据）。
# PIXLOOM_BROWSER_CHANNEL=chrome

# 自动发布：Web / Worker / 发布网关必须使用相同配置。
# 本机开发设置 ENABLED=1 后，pnpm dev 会同时启动网关。
PIXLOOM_PUBLISH_ENABLED=0
PIXLOOM_PUBLISH_DOMAIN=apps.localhost
PIXLOOM_GATEWAY_PORT=4180
# VPS 示例：DOMAIN=apps.pixloom.io，发布地址使用 HTTPS 默认 443。
# PIXLOOM_PUBLISH_DIR=/srv/pixloom/published
# 可选：Caddy 使用其他公开端口时配置，默认本机 4180 / VPS 443。
# PIXLOOM_PUBLISH_PORT=443

# Cloud：两种模式共用服务端加密密钥。生成：openssl rand -hex 32。
# 密钥轮换前先备份；Web / Worker 必须使用相同值。
PIXLOOM_CLOUD_ENCRYPTION_KEY=
# 默认 Pixloom Cloud：预先创建开发池 / 生产池，多个应用共用。
# 开发池配置完整即可启用；生产池仅在首次发布时需要。
# DATABASE_URL 使用 Connect 中 Direct connection 或 Session pooler（5432）。
# 密码含特殊字符时须进行 URL 编码；使用专用空项目，不能复用已有独立应用后端。
PIXLOOM_CLOUD_RUNTIME_URL=http://127.0.0.1:4180
# VPS 示例：https://cloud.pixloom.io；DNS 指向 VPS，Caddy 转发到独立网关。
PIXLOOM_CLOUD_DEV_PROJECT_REF=
PIXLOOM_CLOUD_DEV_DATABASE_URL=
PIXLOOM_CLOUD_DEV_PUBLISHABLE_KEY=
PIXLOOM_CLOUD_DEV_SECRET_KEY=
PIXLOOM_CLOUD_PROD_PROJECT_REF=
PIXLOOM_CLOUD_PROD_DATABASE_URL=
PIXLOOM_CLOUD_PROD_PUBLISHABLE_KEY=
PIXLOOM_CLOUD_PROD_SECRET_KEY=
# 本地平台额度，不会增加 Supabase 套餐额度，也不会自动创建付费资源。
PIXLOOM_CLOUD_MAX_APPS=30
PIXLOOM_CLOUD_APP_MAX_ROWS=10000
PIXLOOM_CLOUD_APP_MAX_BYTES=10485760
PIXLOOM_CLOUD_APP_MAX_FILE_BYTES=10485760
PIXLOOM_CLOUD_POOL_MAX_BYTES=524288000
PIXLOOM_CLOUD_REQUESTS_PER_MINUTE=120
PIXLOOM_CLOUD_MAX_CONNECTIONS=12

# 以下仅供已有 v1 独立托管项目使用；共享模式无需 Management API Token。
# 默认禁止新应用创建独立项目。仅旧部署确有需要时开启，可能产生费用。
PIXLOOM_CLOUD_LEGACY_PROVISIONING=0
PIXLOOM_SUPABASE_ACCESS_TOKEN=
PIXLOOM_SUPABASE_ORGANIZATION=
PIXLOOM_SUPABASE_REGION=apac
PIXLOOM_CLOUD_MAX_PROJECTS=6
# 可选自有 Supabase：创建 OAuth App，注册下列回调。
# http://127.0.0.1:3000/api/cloud/supabase/callback
# OAuth scopes 至少包含项目读取、数据库读取/写入、API key 读取、Edge Functions 写入。
PIXLOOM_SUPABASE_CLIENT_ID=
PIXLOOM_SUPABASE_CLIENT_SECRET=
