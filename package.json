{
  "name": "pixloom",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,worker \"next dev -H 127.0.0.1\" \"tsx watch scripts/worker.ts\"",
    "dev:web": "next dev -H 127.0.0.1",
    "worker": "tsx scripts/worker.ts",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check src scripts tests sandbox docs README.md next.config.js package.json vitest.config.mts",
    "sandbox:doctor": "tsx scripts/sandbox.ts doctor",
    "sandbox:prepare": "tsx scripts/sandbox.ts prepare",
    "sandbox:verify": "tsx scripts/sandbox.ts verify"
  },
  "dependencies": {
    "@next/env": "^14.2.35",
    "acorn": "^8.14.0",
    "lucide-react": "^0.379.0",
    "next": "^14.2.35",
    "parse5": "^7.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^9.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.4.5",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.25.0"
}
