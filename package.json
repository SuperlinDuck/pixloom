{
  "name": "pixloom",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,worker,gateway \"next dev -H 127.0.0.1\" \"tsx watch scripts/worker.ts\" \"tsx watch scripts/gateway.ts\"",
    "dev:web": "next dev -H 127.0.0.1",
    "worker": "tsx scripts/worker.ts",
    "gateway": "tsx scripts/gateway.ts",
    "gateway:config": "tsx scripts/gateway.ts --caddy-config",
    "build": "next build",
    "start": "tsx scripts/start.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check src scripts tests sandbox docs README.md next.config.js package.json vitest.config.mts",
    "sandbox:doctor": "tsx scripts/sandbox.ts doctor",
    "sandbox:prepare": "tsx scripts/sandbox.ts prepare",
    "sandbox:verify": "tsx scripts/sandbox.ts verify",
    "workspace:verify": "tsx scripts/verify-workspace.ts",
    "delivery:verify": "tsx scripts/verify-delivery.ts",
    "publish:verify": "tsx scripts/verify-publication.ts",
    "agent:doctor": "tsx scripts/agent-doctor.ts",
    "agent:verify": "tsx scripts/verify-agent.ts",
    "browser:install": "playwright install chromium",
    "browser:verify": "PIXLOOM_BROWSER_TESTS=1 vitest run tests/browser.test.ts",
    "cloud:verify": "PIXLOOM_CLOUD_TESTS=1 vitest run tests/cloud.test.ts tests/cloud-browser.test.ts",
    "cloud:verify-db": "node --import tsx scripts/verify-cloud-db.ts",
    "cloud:verify-shared": "PIXLOOM_SHARED_DB_TESTS=1 vitest run tests/shared-cloud.test.ts",
    "cloud:pool": "tsx scripts/cloud-pool.ts",
    "cloud:verify-runtime": "PIXLOOM_CLOUD_RUNTIME_TESTS=1 vitest run tests/cloud-runtime.test.ts",
    "admin": "tsx scripts/admin.ts",
    "ops:check": "tsx scripts/ops-check.ts",
    "invite:verify": "node --import tsx scripts/verify-invitations.ts"
  },
  "dependencies": {
    "@next/env": "^14.2.35",
    "acorn": "^8.14.0",
    "google-auth-library": "^11.3.1",
    "lucide-react": "^0.379.0",
    "next": "^14.2.35",
    "parse5": "^7.3.0",
    "pg": "^8.23.1",
    "playwright": "^1.64.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^9.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.4.5",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.25.0"
}
